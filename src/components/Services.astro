---
const services = [
  {
    number: '01',
    title: 'Estratégia & Adoção de IA',
    description:
      'Assessment de maturidade, definição de casos de uso prioritários, roadmap de implementação e governança de dados.',
    items: ['Discovery & assessment de maturidade', 'Roadmap técnico e financeiro', 'Governança, ética e compliance'],
  },
  {
    number: '02',
    title: 'Implementação IA Generativa',
    description:
      'Deploy de Copilot, ChatGPT Enterprise, Claude e modelos open-source, com RAG, agents e integração a sistemas legados.',
    items: ['Copilot, ChatGPT Enterprise, Claude', 'RAG e bases de conhecimento privadas', 'Fine-tuning e modelos customizados'],
  },
  {
    number: '03',
    title: 'Infraestrutura & Servidores',
    description:
      'Data centers, clusters GPU/HPC para treinamento, storage NVMe/all-flash, infraestrutura SAP HANA, backup e redes de baixa latência.',
    items: ['Data centers e clusters HPC/GPU', 'Infraestrutura SAP HANA', 'Storage NVMe e backup', 'IaC (Terraform, Ansible) e GitOps'],
  },
  {
    number: '04',
    title: 'Cloud Híbrida & Kubernetes',
    description:
      'Arquitetura híbrida on-prem + cloud (AWS, Azure, GCP), Kubernetes, migração de workloads, FinOps e disaster recovery.',
    items: ['Arquitetura híbrida e edge', 'Kubernetes (EKS, AKS, GKE)', 'FinOps e disaster recovery'],
  },
  {
    number: '05',
    title: 'Data Engineering & MLOps',
    description:
      'Pipelines de dados em tempo real, data lakes, feature stores, streaming e dashboards executivos.',
    items: ['Data lakes e lakehouses', 'Feature stores e MLOps', 'Streaming e BI executivo'],
  },
  {
    number: '06',
    title: 'Segurança & Compliance IA',
    description:
      'Red teaming para LLMs, guardrails, prevenção de vazamento de dados e conformidade com LGPD, GDPR e AI Act.',
    items: ['AI red teaming e guardrails', 'Prevenção de vazamento (DLP)', 'LGPD, GDPR e AI Act'],
  },
]
---

<section id="servicos" class="section" aria-labelledby="services-title">
  <div class="container">
    <div class="section-heading">
      <div>
        <p class="eyebrow" data-i18n="services.eyebrow">Nossos serviços</p>
        <h2 id="services-title" data-i18n="services.title">Da estratégia à operação em produção</h2>
      </div>
      <p data-i18n="services.desc">Cobrimos o ciclo completo: descoberta, arquitetura, implementação, governança e evolução contínua.</p>
    </div>
    <div class="service-grid">
      {services.map((service) => (
        <article class="service-card">
          <div class="service-card-border" aria-hidden="true"></div>
          <div class="service-top">
            <svg class="service-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
            <span class="service-number">{service.number}</span>
          </div>
          <h3 data-i18n={`services.${service.number}.title`}>{service.title}</h3>
          <p data-i18n={`services.${service.number}.desc`}>{service.description}</p>
          <ul role="list">
            {service.items.map((item, i) => (
              <li data-i18n={`services.${service.number}.items.${i}`}>{item}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .service-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }
  .service-card {
    position: relative;
    padding: 30px;
    background: var(--color-panel);
    border: 1px solid var(--color-line);
    border-radius: 6px;
    overflow: hidden;
  }
  .service-card:first-child {
    border-color: #6c5a37;
    background: linear-gradient(135deg, #24221a, #151719 65%);
  }
  .service-card-border {
    position: absolute;
    inset: 0;
    border-radius: 6px;
    pointer-events: none;
  }
  .service-card-border::before,
  .service-card-border::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 6px;
    border: 2px solid var(--color-gold);
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .service-card-border::before {
    clip-path: polygon(0 0, 100% 0, 100% 3px, 0 3px);
    transform: translateX(-100%);
    animation: border-slide-h 2s linear infinite;
  }
  .service-card-border::after {
    clip-path: polygon(0 100%, 100% 100%, 100% calc(100% - 3px), 0 calc(100% - 3px));
    transform: translateX(100%);
    animation: border-slide-h-reverse 2s linear infinite;
  }
  .service-card:hover .service-card-border::before,
  .service-card:hover .service-card-border::after {
    opacity: 1;
  }
  .service-card::before,
  .service-card::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 6px;
    border-left: 2px solid var(--color-gold);
    border-right: 2px solid var(--color-gold);
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .service-card::before {
    clip-path: polygon(0 0, 3px 0, 3px 100%, 0 100%);
    transform: translateY(-100%);
    animation: border-slide-v 2s linear infinite;
  }
  .service-card::after {
    clip-path: polygon(100% 0, calc(100% - 3px) 0, calc(100% - 3px) 100%, 100% 100%);
    transform: translateY(100%);
    animation: border-slide-v-reverse 2s linear infinite;
  }
  .service-card:hover::before,
  .service-card:hover::after {
    opacity: 1;
  }
  @keyframes border-slide-h {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(100%); }
  }
  @keyframes border-slide-h-reverse {
    0% { transform: translateX(100%); }
    100% { transform: translateX(-100%); }
  }
  @keyframes border-slide-v {
    0% { transform: translateY(-100%); }
    100% { transform: translateY(100%); }
  }
  @keyframes border-slide-v-reverse {
    0% { transform: translateY(100%); }
    100% { transform: translateY(-100%); }
  }
  .service-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 38px;
  }
  .service-top svg {
    width: 30px;
    height: 30px;
    color: var(--color-gold);
  }
  .service-number {
    font: .68rem monospace;
    color: var(--color-muted);
  }
  .service-card > p {
    color: var(--color-muted);
    margin-top: 16px;
    font-size: .88rem;
  }
  .service-card ul {
    padding: 21px 0 0;
    margin: 24px 0 0;
    list-style: none;
    border-top: 1px solid var(--color-line);
  }
  .service-card li {
    display: flex;
    align-items: baseline;
    gap: 12px;
    color: #c9cbc9;
    font-size: .8rem;
    margin-block: 10px;
  }
  .service-card li::before {
    content: '+';
    color: var(--color-gold);
  }
  @media (max-width: 1050px) {
    .service-card { padding: 22px; }
  }
  @media (max-width: 760px) {
    .service-grid { grid-template-columns: 1fr; }
    .service-top { margin-bottom: 26px; }
    .service-card { padding: 28px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .service-card-border::before,
    .service-card-border::after,
    .service-card::before,
    .service-card::after {
      animation: none !important;
    }
  }
</style>