---
interface Props {
  className?: string
}
const { className = '' } = Astro.props
---

<section id="servicos" class="section bg-slate-950 relative {className}" aria-labelledby="services-title">
  <div class="container-custom">
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="inline-block px-4 py-2 rounded-full bg-slate-900/50 border border-slate-700/50 text-gold-400 text-sm font-medium mb-6">
        Nossos Serviços
      </span>
      <h2 id="services-title" class="section-title text-gradient-gold">
        Da Estratégia à<br /><span class="text-slate-100">Operação em Produção</span>
      </h2>
      <p class="section-subtitle mx-auto">
        Cobrimos todo o ciclo de vida: descoberta, arquitetura, implementação, governança e evolução contínua.
      </p>
    </div>

    <!-- Services Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      <!-- Service 1: AI Strategy -->
      <article class="card card-glow group">
        <div class="flex items-start gap-4">
          <div class="flex-shrink-0 w-14 h-14 rounded-xl bg-gradient-to-br from-gold-500/20 to-gold-600/10 border border-gold-500/30 flex items-center justify-center group-hover:border-gold-500 group-hover:bg-gradient-to-br from-gold-500/30 to-gold-600/20 transition-all duration-300">
            <svg class="w-7 h-7 text-gold-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
            </svg>
          </div>
        </div>
        <h3 class="mt-6 text-xl font-bold text-slate-100 font-space-grotesk">Estratégia & Adoção de IA</h3>
        <p class="mt-3 text-slate-400 leading-relaxed">
          Assessment de maturidade, definição de casos de uso prioritários, roadmap de implementação,
          governança de dados e change management para adoção em escala.
        </p>
        <ul class="mt-6 space-y-3" role="list">
          <li class="flex items-center gap-2 text-slate-300">
            <svg class="w-4 h-4 text-gold-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            Discovery & Assessment de Maturidade
          </li>
          <li class="flex items-center gap-2 text-slate-300">
            <svg class="w-4 h-4 text-gold-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            Roadmap Técnico & Financeiro
          </li>
          <li class="flex items-center gap-2 text-slate-300">
            <svg class="w-4 h-4 text-gold-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            Governança, Ética & Compliance
          </li>
          <li class="flex items-center gap-2 text-slate-300">
            <svg class="w-4 h-4 text-gold-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            Treinamento & Change Management
          </li>
        </ul>
      </article>

      <!-- Service 2: Generative AI Implementation -->
      <article class="card card-glow group">
        <div class="flex items-start gap-4">
          <div class="flex-shrink-0 w-14 h-14 rounded-xl bg-gradient-to-br from-gold-500/20 to-gold-600/10 border border-gold-500/30 flex items-center justify-center group-hover:border-gold-500 group-hover:bg-gradient-to-br from-gold-500/30 to-gold-600/20 transition-all duration-300">
            <svg class="w-7 h-7 text-gold-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
            </svg>
          </div>
        </div>
        <h3 class="mt-6 text-xl font-bold text-slate-100 font-space-grotesk">Implementação IA Generativa</h3>
        <p class="mt-3 text-slate-400 leading-relaxed">
          Deploy de Copilot, ChatGPT Enterprise, Claude, modelos open-source (Llama, Mistral) e fine-tuning.
          RAG, agents, function calling e integração com seus sistemas legados.
        </p>
        <ul class="mt-6 space-y-3" role="list">
          <li class="flex items-center gap-2 text-slate-300">
            <svg class="w-4 h-4 text-gold-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            Copilot para Microsoft 365 & GitHub
          </li>
          <li class="flex items-center gap-2 text-slate-300">
            <svg class="w-4 h-4 text-gold-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            ChatGPT Enterprise & Claude Team
          </li>
          <li class="flex items-center gap-2 text-slate-300">
            <svg class="w-4 h-4 text-gold-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            RAG & Knowledge Bases Privadas
          </li>
          <li class="flex items-center gap-2 text-slate-300">
            <svg class="w-4 h-4 text-gold-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            Fine-tuning & Modelos Customizados
          </li>
        </ul>
      </article>

      <!-- Service 3: Infrastructure & Servers -->
      <article class="card card-glow group border-l-4 border-l-gold-500">
        <div class="flex items-start gap-4">
          <div class="flex-shrink-0 w-14 h-14 rounded-xl bg-gradient-to-br from-gold-500/20 to-gold-600/10 border border-gold-500/30 flex items-center justify-center group-hover:border-gold-500 group-hover:bg-gradient-to-br from-gold-500/30 to-gold-600/20 transition-all duration-300">
            <svg class="w-7 h-7 text-gold-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"/>
            </svg>
          </div>
        </div>
        <h3 class="mt-6 text-xl font-bold text-slate-100 font-space-grotesk">Infraestrutura & Servidores</h3>
        <p class="mt-3 text-slate-400 leading-relaxed">
          Projeto, montagem e gestão de data centers, clusters HPC para IA, storage de alta performance,
          redes de baixa latência, backup, DR e automação de infraestrutura como código.
        </p>
        <ul class="mt-6 space-y-3" role="list">
          <li class="flex items-center gap-2 text-slate-300">
            <svg class="w-4 h-4 text-gold-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            Design & Build de Data Centers
          </li>
          <li class="flex items-center gap-2 text-slate-300">
            <svg class="w-4 h-4 text-gold-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            Clusters GPU/HPC para Treinamento
          </li>
          <li class="flex items-center gap-2 text-slate-300">
            <svg class="w-4 h-4 text-gold-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            Storage NVMe/All-Flash & Backup
          </li>
          <li class="flex items-center gap-2 text-slate-300">
            <svg class="w-4 h-4 text-gold-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            IaC (Terraform, Ansible) & GitOps
          </li>
        </ul>
      </article>

      <!-- Service 4: Cloud & Hybrid -->
      <article class="card card-glow group">
        <div class="flex items-start gap-4">
          <div class="flex-shrink-0 w-14 h-14 rounded-xl bg-gradient-to-br from-gold-500/20 to-gold-600/10 border border-gold-500/30 flex items-center justify-center group-hover:border-gold-500 group-hover:bg-gradient-to-br from-gold-500/30 to-gold-600/20 transition-all duration-300">
            <svg class="w-7 h-7 text-gold-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"/>
            </svg>
          </div>
        </div>
        <h3 class="mt-6 text-xl font-bold text-slate-100 font-space-grotesk">Cloud Híbrida & Multi-Cloud</h3>
        <p class="mt-3 text-slate-400 leading-relaxed">
          Arquitetura híbrida on-prem + cloud (AWS, Azure, GCP), Kubernetes, migração de workloads,
          otimização de custos (FinOps) e disaster recovery cross-cloud.
        </p>
        <ul class="mt-6 space-y-3" role="list">
          <li class="flex items-center gap-2 text-slate-300">
            <svg class="w-4 h-4 text-gold-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            Arquitetura Híbrida & Edge
          </li>
          <li class="flex items-center gap-2 text-slate-300">
            <svg class="w-4 h-4 text-gold-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            Kubernetes (EKS, AKS, GKE, OpenShift)
          </li>
          <li class="flex items-center gap-2 text-slate-300">
            <svg class="w-4 h-4 text-gold-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            FinOps & Otimização de Custos
          </li>
          <li class="flex items-center gap-2 text-slate-300">
            <svg class="w-4 h-4 text-gold-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            DR & Business Continuity
          </li>
        </ul>
      </article>

      <!-- Service 5: Data & Analytics -->
      <article class="card card-glow group">
        <div class="flex items-start gap-4">
          <div class="flex-shrink-0 w-14 h-14 rounded-xl bg-gradient-to-br from-gold-500/20 to-gold-600/10 border border-gold-500/30 flex items-center justify-center group-hover:border-gold-500 group-hover:bg-gradient-to-br from-gold-500/30 to-gold-600/20 transition-all duration-300">
            <svg class="w-7 h-7 text-gold-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
            </svg>
          </div>
        </div>
        <h3 class="mt-6 text-xl font-bold text-slate-100 font-space-grotesk">Data Engineering & Analytics</h3>
        <p class="mt-3 text-slate-400 leading-relaxed">
          Pipelines de dados em tempo real, data lakes, feature stores para ML, dashboards executivos
          e governança de dados (Data Mesh, Data Contracts).
        </p>
        <ul class="mt-6 space-y-3" role="list">
          <li class="flex items-center gap-2 text-slate-300">
            <svg class="w-4 h-4 text-gold-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            Data Lakes & Lakehouses (Delta, Iceberg)
          </li>
          <li class="flex items-center gap-2 text-slate-300">
            <svg class="w-4 h-4 text-gold-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            Feature Stores & MLOps
          </li>
          <li class="flex items-center gap-2 text-slate-300">
            <svg class="w-4 h-4 text-gold-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            Streaming (Kafka, Flink, Spark)
          </li>
          <li class="flex items-center gap-2 text-slate-300">
            <svg class="w-4 h-4 text-gold-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            BI & Dashboards Executivos
          </li>
        </ul>
      </article>

      <!-- Service 6: Security & Compliance -->
      <article class="card card-glow group">
        <div class="flex items-start gap-4">
          <div class="flex-shrink-0 w-14 h-14 rounded-xl bg-gradient-to-br from-gold-500/20 to-gold-600/10 border border-gold-500/30 flex items-center justify-center group-hover:border-gold-500 group-hover:bg-gradient-to-br from-gold-500/30 to-gold-600/20 transition-all duration-300">
            <svg class="w-7 h-7 text-gold-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
            </svg>
          </div>
        </div>
        <h3 class="mt-6 text-xl font-bold text-slate-100 font-space-grotesk">Segurança & Compliance IA</h3>
        <p class="mt-3 text-slate-400 leading-relaxed">
          Red teaming para LLMs, guardrails, prevenção de vazamento de dados (DLP), auditoria de viés,
          conformidade LGPD/GDPR/AI Act e gestão de identidades para agentes de IA.
        </p>
        <ul class="mt-6 space-y-3" role="list">
          <li class="flex items-center gap-2 text-slate-300">
            <svg class="w-4 h-4 text-gold-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            AI Red Teaming & Guardrails
          </li>
          <li class="flex items-center gap-2 text-slate-300">
            <svg class="w-4 h-4 text-gold-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            DLP & Prevenção de Vazamento
          </li>
          <li class="flex items-center gap-2 text-slate-300">
            <svg class="w-4 h-4 text-gold-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            Auditoria de Viés & Explainability
          </li>
          <li class="flex items-center gap-2 text-slate-300">
            <svg class="w-4 h-4 text-gold-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            LGPD, GDPR, AI Act Compliance
          </li>
        </ul>
      </article>
    </div>

    <!-- CTA -->
    <div class="text-center mt-16">
      <p class="text-slate-400 mb-6 text-lg">Precisa de algo específico que não listamos?</p>
      <a href="#contato" class="btn-primary inline-flex items-center gap-2">
        Fale com um Especialista
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>
  </div>
</section>