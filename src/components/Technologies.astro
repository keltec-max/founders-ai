---
interface Props {
  className?: string
}
const { className = '' } = Astro.props

// Tech card data
const aiPlatforms = [
  { name: 'GitHub Copilot', category: 'Code Gen', logo: 'copilot' },
  { name: 'ChatGPT Enterprise', category: 'LLM', logo: 'openai' },
  { name: 'Claude', category: 'LLM', logo: 'anthropic' },
  { name: 'Azure OpenAI', category: 'Enterprise', logo: 'azure' },
  { name: 'AWS Bedrock', category: 'Managed', logo: 'aws' },
  { name: 'Vertex AI', category: 'Managed', logo: 'gcp' },
  { name: 'Llama / Mistral', category: 'Open Source', logo: 'opensource' },
]

const infrastructure = [
  { name: 'Dell EMC / HPE', category: 'Hardware', logo: 'dell' },
  { name: 'NVIDIA DGX / HGX', category: 'GPU Compute', logo: 'nvidia' },
  { name: 'VMware / vSphere', category: 'Virtualização', logo: 'vmware' },
  { name: 'Red Hat OpenShift', category: 'Kubernetes', logo: 'redhat' },
  { name: 'Pure Storage', category: 'All-Flash', logo: 'purestorage' },
  { name: 'Cisco / Arista', category: 'Networking', logo: 'cisco' },
]

const cloudDevOps = [
  { name: 'AWS', category: 'Cloud', logo: 'aws' },
  { name: 'Microsoft Azure', category: 'Cloud', logo: 'azure' },
  { name: 'Google Cloud', category: 'Cloud', logo: 'gcp' },
  { name: 'Terraform', category: 'IaC', logo: 'terraform' },
  { name: 'Ansible', category: 'Automation', logo: 'ansible' },
  { name: 'Kubernetes', category: 'Orchestration', logo: 'k8s' },
  { name: 'Kafka / Flink', category: 'Streaming', logo: 'kafka' },
  { name: 'Databricks', category: 'Data & AI', logo: 'databricks' },
]

const security = [
  { name: 'HashiCorp Vault', category: 'Secrets', logo: 'vault' },
  { name: 'Splunk / Datadog', category: 'Observability', logo: 'datadog' },
  { name: 'Grafana / Prometheus', category: 'Monitoring', logo: 'grafana' },
  { name: 'Checkov / OPA', category: 'Policy as Code', logo: 'opa' },
  { name: 'Snyk / Aqua', category: 'AppSec', logo: 'snyk' },
  { name: 'Vanta / Drata', category: 'Compliance', logo: 'vanta' },
]

const certifications = [
  { name: 'Microsoft Solutions Partner', sub: 'Data & AI • Infrastructure' },
  { name: 'AWS Advanced Consulting Partner', sub: 'Machine Learning Competency' },
  { name: 'Google Cloud Partner', sub: 'Data Analytics Specialization' },
  { name: 'NVIDIA Partner Network', sub: 'DGX-Ready & Compute' },
  { name: 'ISO 27001 Certified', sub: 'Gestão de Segurança da Informação' },
  { name: 'SOC 2 Type II', sub: 'Controles de Segurança e Disponibilidade' },
]

// Logo SVG map
