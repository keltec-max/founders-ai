---
const categories = [
  { key: 'ai', title: 'Inteligência artificial', items: ['Microsoft Copilot', 'ChatGPT', 'Claude', 'Llama'] },
  { key: 'cloud', title: 'Cloud', items: ['Microsoft Azure', 'AWS', 'Google Cloud'] },
  { key: 'infra', title: 'Infraestrutura & automação', items: ['Linux', 'VMware', 'Kubernetes', 'Terraform', 'Ansible'] },
  { key: 'obs', title: 'Observabilidade', items: ['Grafana', 'Prometheus', 'Datadog'] },
];
---
<section id="tecnologias" class="section tech-section" aria-labelledby="tech-title">
  <div class="container">
    <div class="section-heading">
      <div>
        <p class="eyebrow" data-i18n="tech.eyebrow">03 / Ecossistema tecnológico</p>
        <h2 id="tech-title" data-i18n="tech.title">A ferramenta certa.<br /><span class="muted">Para o seu cenário.</span></h2>
      </div>
      <p data-i18n="tech.desc">A escolha começa no problema, não no fornecedor. Avaliamos as tecnologias conforme os requisitos de cada projeto.</p>
    </div>
    <div class="tech-list">
      {categories.map((category) => (
        <div class="tech-row">
          <h3 data-i18n={`tech.cat.${category.key}.title`}>{category.title}</h3>
          <ul role="list">
            {category.items.map((item, i) => (
              <li data-i18n={`tech.cat.${category.key}.items.${i}`}>{item}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <p class="tech-disclaimer" data-i18n="tech.disclaimer">Tecnologias de referência. As marcas citadas pertencem aos seus respectivos titulares e não representam vínculo de parceria ou certificação.</p>
  </div>
</section>
