---

<section id="tecnologias" class={`section bg-slate-950/50 relative ${className}`} aria-labelledby="tech-title">
  <div class="container-custom">
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="inline-block px-4 py-2 rounded-full bg-slate-900/50 border border-slate-700/50 text-gold-400 text-sm font-medium mb-6">
        Tecnologias & Parcerias
      </span>
      <h2 id="tech-title" class="section-title text-gradient-gold">
        As Melhores Ferramentas,<br /><span class="text-slate-100">A Melhor Arquitetura</span>
      </h2>
      <p class="section-subtitle mx-auto">
        Somos agnósticos de tecnologia — escolhemos o que há de melhor para cada caso de uso.
        Parcerias oficiais com os principais players do mercado.
      </p>
    </div>

    <!-- Tech Categories -->
    <div class="space-y-16">
      <!-- AI Platforms -->
      <div>
        <h3 class="text-lg font-semibold text-gold-400 mb-8 flex items-center gap-3">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
          </svg>
          Plataformas de IA Generativa
        </h3>
        <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-7 gap-4 lg:gap-6">
          {aiPlatforms.map(item => (
            <article class="card p-5 group relative overflow-hidden" tabindex="0">
              <div class="absolute inset-0 bg-gradient-to-br from-gold-500/5 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500" />
              <div class="relative flex flex-col items-center text-center h-full">
                <div class="w-14 h-14 mx-auto mb-4 rounded-xl bg-slate-900/50 border border-slate-700/50 flex items-center justify-center group-hover:border-gold-500/50 group-hover:bg-gold-500/10 transition-all duration-300">
                  <span set:html={getLogoSVG(item.logo)} />
                </div>
                <h4 class="font-semibold text-slate-100 text-sm leading-snug">{item.name}</h4>
                <span class="text-xs text-slate-500 mt-1 px-2 py-0.5 rounded bg-slate-900/50 border border-slate-800/50">{item.category}</span>
              </div>
            </article>
          ))}
        </div>
      </div>

      <!-- Infrastructure -->
      <div>
        <h3 class="text-lg font-semibold text-gold-400 mb-8 flex items-center gap-3">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"/>
          </svg>
          Infraestrutura & Servidores
        </h3>
        <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-4 lg:gap-6">
          {infrastructure.map(item => (
            <article class="card p-5 group relative overflow-hidden" tabindex="0">
              <div class="absolute inset-0 bg-gradient-to-br from-gold-500/5 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500" />
              <div class="relative flex flex-col items-center text-center h-full">
                <div class="w-14 h-14 mx-auto mb-4 rounded-xl bg-slate-900/50 border border-slate-700/50 flex items-center justify-center group-hover:border-gold-500/50 group-hover:bg-gold-500/10 transition-all duration-300">
                  <span set:html={getLogoSVG(item.logo)} />
                </div>
                <h4 class="font-semibold text-slate-100 text-sm leading-snug">{item.name}</h4>
                <span class="text-xs text-slate-500 mt-1 px-2 py-0.5 rounded bg-slate-900/50 border border-slate-800/50">{item.category}</span>
              </div>
            </article>
          ))}
        </div>
      </div>

      <!-- Cloud & DevOps -->
      <div>
        <h3 class="text-lg font-semibold text-gold-400 mb-8 flex items-center gap-3">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"/>
          </svg>
          Cloud, DevOps & Data
        </h3>
        <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-8 gap-4 lg:gap-6">
          {cloudDevOps.map(item => (
            <article class="card p-5 group relative overflow-hidden" tabindex="0">
              <div class="absolute inset-0 bg-gradient-to-br from-gold-500/5 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500" />
              <div class="relative flex flex-col items-center text-center h-full">
                <div class="w-14 h-14 mx-auto mb-4 rounded-xl bg-slate-900/50 border border-slate-700/50 flex items-center justify-center group-hover:border-gold-500/50 group-hover:bg-gold-500/10 transition-all duration-300">
                  <span set:html={getLogoSVG(item.logo)} />
                </div>
                <h4 class="font-semibold text-slate-100 text-sm leading-snug">{item.name}</h4>
                <span class="text-xs text-slate-500 mt-1 px-2 py-0.5 rounded bg-slate-900/50 border border-slate-800/50">{item.category}</span>
              </div>
            </article>
          ))}
        </div>
      </div>

      <!-- Security & Observability -->
      <div>
        <h3 class="text-lg font-semibold text-gold-400 mb-8 flex items-center gap-3">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
          </svg>
          Segurança, Observabilidade & Governança
        </h3>
        <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-4 lg:gap-6">
          {security.map(item => (
            <article class="card p-5 group relative overflow-hidden" tabindex="0">
              <div class="absolute inset-0 bg-gradient-to-br from-gold-500/5 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500" />
              <div class="relative flex flex-col items-center text-center h-full">
                <div class="w-14 h-14 mx-auto mb-4 rounded-xl bg-slate-900/50 border border-slate-700/50 flex items-center justify-center group-hover:border-gold-500/50 group-hover:bg-gold-500/10 transition-all duration-300">
                  <span set:html={getLogoSVG(item.logo)} />
                </div>
                <h4 class="font-semibold text-slate-100 text-sm leading-snug">{item.name}</h4>
                <span class="text-xs text-slate-500 mt-1 px-2 py-0.5 rounded bg-slate-900/50 border border-slate-800/50">{item.category}</span>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>

    <!-- Certification Badges -->
    <div class="mt-16 pt-16 border-t border-slate-800/50">
      <h3 class="text-lg font-semibold text-gold-400 mb-8 text-center">Certificações & Competências</h3>
      <div class="flex flex-wrap justify-center gap-4 lg:gap-6">
        {certifications.map(cert => (
          <div class="card p-4 lg:p-6 min-w-[200px] text-center group">
            <div class="w-10 h-10 mx-auto mb-3 rounded-lg bg-gradient-to-br from-gold-500/20 to-gold-600/10 border border-gold-500/30 flex items-center justify-center group-hover:bg-gradient-to-br from-gold-500/30 to-gold-600/20 group-hover:border-gold-500 transition-all duration-300">
              <svg class="w-5 h-5 text-gold-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
            </div>
            <h4 class="font-semibold text-slate-100 text-sm leading-snug">{cert.name}</h4>
            <p class="text-xs text-slate-500 mt-1">{cert.sub}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

