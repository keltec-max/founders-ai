---
interface Props {
  className?: string
}
const { className = '' } = Astro.props
---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden {className}" aria-labelledby="hero-title">
  <!-- Animated Data Center Background -->
  <div class="absolute inset-0 z-0" aria-hidden="true">
    <!-- Grid pattern -->
    <div class="absolute inset-0 bg-grid-pattern opacity-50" />

    <!-- Radial gradient glow -->
    <div class="absolute inset-0 bg-radial-gold" />

    <!-- Floating particles -->
    <div class="absolute inset-0 overflow-hidden">
      <div class="particle" style="top: 10%; left: 10%; animation-delay: 0s;"></div>
      <div class="particle" style="top: 20%; left: 80%; animation-delay: 1s;"></div>
      <div class="particle" style="top: 60%; left: 15%; animation-delay: 2s;"></div>
      <div class="particle" style="top: 80%; left: 75%; animation-delay: 3s;"></div>
      <div class="particle" style="top: 40%; left: 50%; animation-delay: 4s;"></div>
      <div class="particle" style="top: 30%; left: 30%; animation-delay: 5s;"></div>
      <div class="particle" style="top: 70%; left: 60%; animation-delay: 6s;"></div>
      <div class="particle" style="top: 15%; left: 65%; animation-delay: 7s;"></div>
    </div>

    <!-- Data center server racks animation -->
    <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-full max-w-5xl h-[60vh] opacity-30" aria-hidden="true">
      <svg viewBox="0 0 800 400" class="w-full h-full" preserveAspectRatio="none">
        <defs>
          <linearGradient id="serverGlow" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#d0ac3c" stop-opacity="0.3" />
            <stop offset="50%" stop-color="#d0ac3c" stop-opacity="0.1" />
            <stop offset="100%" stop-color="#1e293b" stop-opacity="0" />
          </linearGradient>
          <linearGradient id="rackGradient" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#1e293b" />
            <stop offset="50%" stop-color="#334155" />
            <stop offset="100%" stop-color="#1e293b" />
          </linearGradient>
          <filter id="glow" x="-50%" y="-50%" width="200%" height="200%">
            <feGaussianBlur stdDeviation="3" result="coloredBlur" />
            <feMerge>
              <feMergeNode in="coloredBlur" />
              <feMergeNode in="SourceGraphic" />
            </feMerge>
          </filter>
        </defs>

        <!-- Server Racks -->
        <g class="server-racks" filter="url(#glow)">
          <!-- Rack 1 -->
          <rect x="50" y="50" width="100" height="300" rx="4" fill="url(#rackGradient)" stroke="#d0ac3c" stroke-width="1" opacity="0.6">
            <animate attributeName="opacity" values="0.6;0.8;0.6" dur="4s" repeatCount="indefinite" begin="0s" />
          </rect>
          <g class="rack-leds">
            <rect x="65" y="70" width="70" height="8" rx="2" fill="#d0ac3c" opacity="0.9">
              <animate attributeName="opacity" values="0.9;0.3;0.9" dur="1.5s" repeatCount="indefinite" begin="0s" />
            </rect>
            <rect x="65" y="90" width="70" height="8" rx="2" fill="#22c55e" opacity="0.9">
              <animate attributeName="opacity" values="0.9;0.3;0.9" dur="1.5s" repeatCount="indefinite" begin="0.2s" />
            </rect>
            <rect x="65" y="110" width="70" height="8" rx="2" fill="#d0ac3c" opacity="0.9">
              <animate attributeName="opacity" values="0.9;0.3;0.9" dur="1.5s" repeatCount="indefinite" begin="0.4s" />
            </rect>
            <rect x="65" y="130" width="70" height="8" rx="2" fill="#3b82f6" opacity="0.9">
              <animate attributeName="opacity" values="0.9;0.3;0.9" dur="1.5s" repeatCount="indefinite" begin="0.6s" />
            </rect>
            <rect x="65" y="150" width="70" height="8" rx="2" fill="#d0ac3c" opacity="0.9">
              <animate attributeName="opacity" values="0.9;0.3;0.9" dur="1.5s" repeatCount="indefinite" begin="0.8s" />
            </rect>
            <rect x="65" y="170" width="70" height="8" rx="2" fill="#22c55e" opacity="0.9">
              <animate attributeName="opacity" values="0.9;0.3;0.9" dur="1.5s" repeatCount="indefinite" begin="1s" />
            </rect>
            <rect x="65" y="190" width="70" height="8" rx="2" fill="#d0ac3c" opacity="0.9">
              <animate attributeName="opacity" values="0.9;0.3;0.9" dur="1.5s" repeatCount="indefinite" begin="1.2s" />
            </rect>
            <rect x="65" y="210" width="70" height="8" rx="2" fill="#3b82f6" opacity="0.9">
              <animate attributeName="opacity" values="0.9;0.3;0.9" dur="1.5s" repeatCount="indefinite" begin="1.4s" />
            </rect>
            <rect x="65" y="230" width="70" height="8" rx="2" fill="#d0ac3c" opacity="0.9">
              <animate attributeName="opacity" values="0.9;0.3;0.9" dur="1.5s" repeatCount="indefinite" begin="1.6s" />
            </rect>
            <rect x="65" y="250" width="70" height="8" rx="2" fill="#22c55e" opacity="0.9">
              <animate attributeName="opacity" values="0.9;0.3;0.9" dur="1.5s" repeatCount="indefinite" begin="1.8s" />
            </rect>
            <rect x="65" y="270" width="70" height="8" rx="2" fill="#d0ac3c" opacity="0.9">
              <animate attributeName="opacity" values="0.9;0.3;0.9" dur="1.5s" repeatCount="indefinite" begin="2s" />
            </rect>
            <rect x="65" y="290" width="70" height="8" rx="2" fill="#3b82f6" opacity="0.9">
              <animate attributeName="opacity" values="0.9;0.3;0.9" dur="1.5s" repeatCount="indefinite" begin="2.2s" />
            </rect>
          </g>

          <!-- Rack 2 -->
          <rect x="180" y="80" width="100" height="270" rx="4" fill="url(#rackGradient)" stroke="#d0ac3c" stroke-width="1" opacity="0.5">
            <animate attributeName="opacity" values="0.5;0.7;0.5" dur="4s" repeatCount="indefinite" begin="0.5s" />
          </rect>
          <g class="rack-leds">
            <rect x="195" y="100" width="70" height="8" rx="2" fill="#22c55e" opacity="0.8">
              <animate attributeName="opacity" values="0.8;0.2;0.8" dur="1.8s" repeatCount="indefinite" begin="0.3s" />
            </rect>
            <rect x="195" y="120" width="70" height="8" rx="2" fill="#d0ac3c" opacity="0.8">
              <animate attributeName="opacity" values="0.8;0.2;0.8" dur="1.8s" repeatCount="indefinite" begin="0.5s" />
            </rect>
            <rect x="195" y="140" width="70" height="8" rx="2" fill="#3b82f6" opacity="0.8">
              <animate attributeName="opacity" values="0.8;0.2;0.8" dur="1.8s" repeatCount="indefinite" begin="0.7s" />
            </rect>
            <rect x="195" y="160" width="70" height="8" rx="2" fill="#22c55e" opacity="0.8">
              <animate attributeName="opacity" values="0.8;0.2;0.8" dur="1.8s" repeatCount="indefinite" begin="0.9s" />
            </rect>
            <rect x="195" y="180" width="70" height="8" rx="2" fill="#d0ac3c" opacity="0.8">
              <animate attributeName="opacity" values="0.8;0.2;0.8" dur="1.8s" repeatCount="indefinite" begin="1.1s" />
            </rect>
            <rect x="195" y="200" width="70" height="8" rx="2" fill="#3b82f6" opacity="0.8">
              <animate attributeName="opacity" values="0.8;0.2;0.8" dur="1.8s" repeatCount="indefinite" begin="1.3s" />
            </rect>
            <rect x="195" y="220" width="70" height="8" rx="2" fill="#22c55e" opacity="0.8">
              <animate attributeName="opacity" values="0.8;0.2;0.8" dur="1.8s" repeatCount="indefinite" begin="1.5s" />
            </rect>
            <rect x="195" y="240" width="70" height="8" rx="2" fill="#d0ac3c" opacity="0.8">
              <animate attributeName="opacity" values="0.8;0.2;0.8" dur="1.8s" repeatCount="indefinite" begin="1.7s" />
            </rect>
            <rect x="195" y="260" width="70" height="8" rx="2" fill="#3b82f6" opacity="0.8">
              <animate attributeName="opacity" values="0.8;0.2;0.8" dur="1.8s" repeatCount="indefinite" begin="1.9s" />
            </rect>
            <rect x="195" y="280" width="70" height="8" rx="2" fill="#22c55e" opacity="0.8">
              <animate attributeName="opacity" values="0.8;0.2;0.8" dur="1.8s" repeatCount="indefinite" begin="2.1s" />
            </rect>
            <rect x="195" y="300" width="70" height="8" rx="2" fill="#d0ac3c" opacity="0.8">
              <animate attributeName="opacity" values="0.8;0.2;0.8" dur="1.8s" repeatCount="indefinite" begin="2.3s" />
            </rect>
          </g>

          <!-- Rack 3 -->
          <rect x="310" y="40" width="100" height="310" rx="4" fill="url(#rackGradient)" stroke="#d0ac3c" stroke-width="1" opacity="0.7">
            <animate attributeName="opacity" values="0.7;0.9;0.7" dur="3.5s" repeatCount="indefinite" begin="0.2s" />
          </rect>
          <g class="rack-leds">
            <rect x="325" y="60" width="70" height="8" rx="2" fill="#3b82f6" opacity="0.9">
              <animate attributeName="opacity" values="0.9;0.4;0.9" dur="1.2s" repeatCount="indefinite" begin="0.1s" />
            </rect>
            <rect x="325" y="80" width="70" height="8" rx="2" fill="#d0ac3c" opacity="0.9">
              <animate attributeName="opacity" values="0.9;0.4;0.9" dur="1.2s" repeatCount="indefinite" begin="0.3s" />
            </rect>
            <rect x="325" y="100" width="70" height="8" rx="2" fill="#22c55e" opacity="0.9">
              <animate attributeName="opacity" values="0.9;0.4;0.9" dur="1.2s" repeatCount="indefinite" begin="0.5s" />
            </rect>
            <rect x="325" y="120" width="70" height="8" rx="2" fill="#3b82f6" opacity="0.9">
              <animate attributeName="opacity" values="0.9;0.4;0.9" dur="1.2s" repeatCount="indefinite" begin="0.7s" />
            </rect>
            <rect x="325" y="140" width="70" height="8" rx="2" fill="#d0ac3c" opacity="0.9">
              <animate attributeName="opacity" values="0.9;0.4;0.9" dur="1.2s" repeatCount="indefinite" begin="0.9s" />
            </rect>
            <rect x="325" y="160" width="70" height="8" rx="2" fill="#22c55e" opacity="0.9">
              <animate attributeName="opacity" values="0.9;0.4;0.9" dur="1.2s" repeatCount="indefinite" begin="1.1s" />
            </rect>
            <rect x="325" y="180" width="70" height="8" rx="2" fill="#3b82f6" opacity="0.9">
              <animate attributeName="opacity" values="0.9;0.4;0.9" dur="1.2s" repeatCount="indefinite" begin="1.3s" />
            </rect>
            <rect x="325" y="200" width="70" height="8" rx="2" fill="#d0ac3c" opacity="0.9">
              <animate attributeName="opacity" values="0.9;0.4;0.9" dur="1.2s" repeatCount="indefinite" begin="1.5s" />
            </rect>
            <rect x="325" y="220" width="70" height="8" rx="2" fill="#22c55e" opacity="0.9">
              <animate attributeName="opacity" values="0.9;0.4;0.9" dur="1.2s" repeatCount="indefinite" begin="1.7s" />
            </rect>
            <rect x="325" y="240" width="70" height="8" rx="2" fill="#3b82f6" opacity="0.9">
              <animate attributeName="opacity" values="0.9;0.4;0.9" dur="1.2s" repeatCount="indefinite" begin="1.9s" />
            </rect>
            <rect x="325" y="260" width="70" height="8" rx="2" fill="#d0ac3c" opacity="0.9">
              <animate attributeName="opacity" values="0.9;0.4;0.9" dur="1.2s" repeatCount="indefinite" begin="2.1s" />
            </rect>
            <rect x="325" y="280" width="70" height="8" rx="2" fill="#22c55e" opacity="0.9">
              <animate attributeName="opacity" values="0.9;0.4;0.9" dur="1.2s" repeatCount="indefinite" begin="2.3s" />
            </rect>
            <rect x="325" y="300" width="70" height="8" rx="2" fill="#3b82f6" opacity="0.9">
              <animate attributeName="opacity" values="0.9;0.4;0.9" dur="1.2s" repeatCount="indefinite" begin="2.5s" />
            </rect>
            <rect x="325" y="320" width="70" height="8" rx="2" fill="#d0ac3c" opacity="0.9">
              <animate attributeName="opacity" values="0.9;0.4;0.9" dur="1.2s" repeatCount="indefinite" begin="2.7s" />
            </rect>
          </g>

          <!-- Rack 4 -->
          <rect x="440" y="70" width="100" height="280" rx="4" fill="url(#rackGradient)" stroke="#d0ac3c" stroke-width="1" opacity="0.55">
            <animate attributeName="opacity" values="0.55;0.75;0.55" dur="4.2s" repeatCount="indefinite" begin="0.8s" />
          </rect>
          <g class="rack-leds">
            <rect x="455" y="90" width="70" height="8" rx="2" fill="#d0ac3c" opacity="0.85">
              <animate attributeName="opacity" values="0.85;0.25;0.85" dur="1.6s" repeatCount="indefinite" begin="0.4s" />
            </rect>
            <rect x="455" y="110" width="70" height="8" rx="2" fill="#22c55e" opacity="0.85">
              <animate attributeName="opacity" values="0.85;0.25;0.85" dur="1.6s" repeatCount="indefinite" begin="0.6s" />
            </rect>
            <rect x="455" y="130" width="70" height="8" rx="2" fill="#3b82f6" opacity="0.85">
              <animate attributeName="opacity" values="0.85;0.25;0.85" dur="1.6s" repeatCount="indefinite" begin="0.8s" />
            </rect>
            <rect x="455" y="150" width="70" height="8" rx="2" fill="#d0ac3c" opacity="0.85">
              <animate attributeName="opacity" values="0.85;0.25;0.85" dur="1.6s" repeatCount="indefinite" begin="1s" />
            </rect>
            <rect x="455" y="170" width="70" height="8" rx="2" fill="#22c55e" opacity="0.85">
              <animate attributeName="opacity" values="0.85;0.25;0.85" dur="1.6s" repeatCount="indefinite" begin="1.2s" />
            </rect>
            <rect x="455" y="190" width="70" height="8" rx="2" fill="#3b82f6" opacity="0.85">
              <animate attributeName="opacity" values="0.85;0.25;0.85" dur="1.6s" repeatCount="indefinite" begin="1.4s" />
            </rect>
            <rect x="455" y="210" width="70" height="8" rx="2" fill="#d0ac3c" opacity="0.85">
              <animate attributeName="opacity" values="0.85;0.25;0.85" dur="1.6s" repeatCount="indefinite" begin="1.6s" />
            </rect>
            <rect x="455" y="230" width="70" height="8" rx="2" fill="#22c55e" opacity="0.85">
              <animate attributeName="opacity" values="0.85;0.25;0.85" dur="1.6s" repeatCount="indefinite" begin="1.8s" />
            </rect>
            <rect x="455" y="250" width="70" height="8" rx="2" fill="#3b82f6" opacity="0.85">
              <animate attributeName="opacity" values="0.85;0.25;0.85" dur="1.6s" repeatCount="indefinite" begin="2s" />
            </rect>
            <rect x="455" y="270" width="70" height="8" rx="2" fill="#d0ac3c" opacity="0.85">
              <animate attributeName="opacity" values="0.85;0.25;0.85" dur="1.6s" repeatCount="indefinite" begin="2.2s" />
            </rect>
            <rect x="455" y="290" width="70" height="8" rx="2" fill="#22c55e" opacity="0.85">
              <animate attributeName="opacity" values="0.85;0.25;0.85" dur="1.6s" repeatCount="indefinite" begin="2.4s" />
            </rect>
            <rect x="455" y="310" width="70" height="8" rx="2" fill="#3b82f6" opacity="0.85">
              <animate attributeName="opacity" values="0.85;0.25;0.85" dur="1.6s" repeatCount="indefinite" begin="2.6s" />
            </rect>
          </g>

          <!-- Rack 5 -->
          <rect x="570" y="60" width="100" height="290" rx="4" fill="url(#rackGradient)" stroke="#d0ac3c" stroke-width="1" opacity="0.65">
            <animate attributeName="opacity" values="0.65;0.85;0.65" dur="3.8s" repeatCount="indefinite" begin="0.3s" />
          </rect>
          <g class="rack-leds">
            <rect x="585" y="80" width="70" height="8" rx="2" fill="#22c55e" opacity="0.88">
              <animate attributeName="opacity" values="0.88;0.28;0.88" dur="1.4s" repeatCount="indefinite" begin="0.2s" />
            </rect>
            <rect x="585" y="100" width="70" height="8" rx="2" fill="#d0ac3c" opacity="0.88">
              <animate attributeName="opacity" values="0.88;0.28;0.88" dur="1.4s" repeatCount="indefinite" begin="0.4s" />
            </rect>
            <rect x="585" y="120" width="70" height="8" rx="2" fill="#3b82f6" opacity="0.88">
              <animate attributeName="opacity" values="0.88;0.28;0.88" dur="1.4s" repeatCount="indefinite" begin="0.6s" />
            </rect>
            <rect x="585" y="140" width="70" height="8" rx="2" fill="#22c55e" opacity="0.88">
              <animate attributeName="opacity" values="0.88;0.28;0.88" dur="1.4s" repeatCount="indefinite" begin="0.8s" />
            </rect>
            <rect x="585" y="160" width="70" height="8" rx="2" fill="#d0ac3c" opacity="0.88">
              <animate attributeName="opacity" values="0.88;0.28;0.88" dur="1.4s" repeatCount="indefinite" begin="1s" />
            </rect>
            <rect x="585" y="180" width="70" height="8" rx="2" fill="#3b82f6" opacity="0.88">
              <animate attributeName="opacity" values="0.88;0.28;0.88" dur="1.4s" repeatCount="indefinite" begin="1.2s" />
            </rect>
            <rect x="585" y="200" width="70" height="8" rx="2" fill="#22c55e" opacity="0.88">
              <animate attributeName="opacity" values="0.88;0.28;0.88" dur="1.4s" repeatCount="indefinite" begin="1.4s" />
            </rect>
            <rect x="585" y="220" width="70" height="8" rx="2" fill="#d0ac3c" opacity="0.88">
              <animate attributeName="opacity" values="0.88;0.28;0.88" dur="1.4s" repeatCount="indefinite" begin="1.6s" />
            </rect>
            <rect x="585" y="240" width="70" height="8" rx="2" fill="#22c55e" opacity="0.88">
              <animate attributeName="opacity" values="0.88;0.28;0.88" dur="1.4s" repeatCount="indefinite" begin="1.8s" />
            </rect>
            <rect x="585" y="260" width="70" height="8" rx="2" fill="#3b82f6" opacity="0.88">
              <animate attributeName="opacity" values="0.88;0.28;0.88" dur="1.4s" repeatCount="indefinite" begin="2s" />
            </rect>
            <rect x="585" y="280" width="70" height="8" rx="2" fill="#d0ac3c" opacity="0.88">
              <animate attributeName="opacity" values="0.88;0.28;0.88" dur="1.4s" repeatCount="indefinite" begin="2.2s" />
            </rect>
            <rect x="585" y="300" width="70" height="8" rx="2" fill="#22c55e" opacity="0.88">
              <animate attributeName="opacity" values="0.88;0.28;0.88" dur="1.4s" repeatCount="indefinite" begin="2.4s" />
            </rect>
            <rect x="585" y="320" width="70" height="8" rx="2" fill="#3b82f6" opacity="0.88">
              <animate attributeName="opacity" values="0.88;0.28;0.88" dur="1.4s" repeatCount="indefinite" begin="2.6s" />
            </rect>
          </g>
        </g>

        <!-- Floor reflection -->
        <rect x="50" y="350" width="620" height="30" fill="url(#serverGlow)" opacity="0.3" />

        <!-- Network cables -->
        <g stroke="#d0ac3c" stroke-width="1" opacity="0.3">
          <line x1="100" y1="50" x2="100" y2="0" stroke-dasharray="5,5">
            <animate attributeName="stroke-dashoffset" values="0;10" dur="2s" repeatCount="indefinite" />
          </line>
          <line x1="230" y1="80" x2="230" y2="0" stroke-dasharray="5,5">
            <animate attributeName="stroke-dashoffset" values="0;10" dur="2s" repeatCount="indefinite" begin="0.5s" />
          </line>
          <line x1="360" y1="40" x2="360" y2="0" stroke-dasharray="5,5">
            <animate attributeName="stroke-dashoffset" values="0;10" dur="2s" repeatCount="indefinite" begin="0.2s" />
          </line>
          <line x1="490" y1="70" x2="490" y2="0" stroke-dasharray="5,5">
            <animate attributeName="stroke-dashoffset" values="0;10" dur="2s" repeatCount="indefinite" begin="0.8s" />
          </line>
          <line x1="620" y1="60" x2="620" y2="0" stroke-dasharray="5,5">
            <animate attributeName="stroke-dashoffset" values="0;10" dur="2s" repeatCount="indefinite" begin="0.3s" />
          </line>
        </g>
      </svg>
    </div>

    <!-- Floating data particles -->
    <div class="absolute inset-0" aria-hidden="true">
      <svg class="w-full h-full" viewBox="0 0 100 100" preserveAspectRatio="none">
        <defs>
          <radialGradient id="particleGlow" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#d0ac3c" stop-opacity="0.8" />
            <stop offset="100%" stop-color="#d0ac3c" stop-opacity="0" />
          </radialGradient>
        </defs>
        <g class="data-particles">
          <circle cx="10" cy="10" r="1.5" fill="url(#particleGlow)">
            <animate attributeName="cy" values="10;90;10" dur="8s" repeatCount="indefinite" />
            <animate attributeName="opacity" values="0.8;0.2;0.8" dur="4s" repeatCount="indefinite" />
          </circle>
          <circle cx="25" cy="20" r="1" fill="url(#particleGlow)">
            <animate attributeName="cy" values="20;95;20" dur="10s" repeatCount="indefinite" begin="1s" />
            <animate attributeName="opacity" values="0.6;0.1;0.6" dur="5s" repeatCount="indefinite" />
          </circle>
          <circle cx="40" cy="5" r="1.2" fill="url(#particleGlow)">
            <animate attributeName="cy" values="5;85;5" dur="7s" repeatCount="indefinite" begin="0.5s" />
            <animate attributeName="opacity" values="0.7;0.3;0.7" dur="3.5s" repeatCount="indefinite" />
          </circle>
          <circle cx="55" cy="30" r="0.8" fill="url(#particleGlow)">
            <animate attributeName="cy" values="30;90;30" dur="9s" repeatCount="indefinite" begin="1.5s" />
