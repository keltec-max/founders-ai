---
const mediaPath = `${import.meta.env.BASE_URL}assets/videos/`;
---
<section class="hero" aria-labelledby="hero-title" aria-describedby="hero-desc">
  <div class="container">
    <div class="hero-grid">
      <div class="hero-copy">
        <p class="eyebrow" data-i18n="hero.eyebrow">Consultoria de inteligência artificial e infraestrutura</p>
        <h1 id="hero-title" data-i18n="hero.title">IA aplicada <em class="accent">com infraestrutura de confiança</em></h1>
        <p id="hero-desc" class="hero-description" data-i18n="hero.desc">
          Ajudamos empresas a adotar Copilot, ChatGPT Enterprise, Claude e modelos open-source com
          governança, servidores adequados e implantação em escala — da estratégia ao ambiente de
          produção.
        </p>
        <div class="hero-actions">
          <a href="#contato" class="button button-primary" data-i18n="hero.btn-iniciar">Iniciar projeto</a>
          <a href="#servicos" class="button button-secondary" data-i18n="hero.btn-servicos">Ver serviços</a>
        </div>
      </div>
      <div class="hero-visual" aria-hidden="true">
        <video class="hero-video" autoplay loop muted playsinline poster={`${mediaPath}hero-poster.jpg`}>
          <source src={`${mediaPath}hero-bg.mp4`} type="video/mp4">
        </video>
        <img class="hero-fallback" hidden data-src={`${mediaPath}hero-fallback.gif`} alt="">
        <div class="visual-top">
          <span data-i18n="hero.visual.ia01">ia-01</span><span data-i18n="hero.visual.ativo">ativo</span><span data-i18n="hero.visual.producao">produção</span>
        </div>
        <div class="visual-bottom">
          <span data-i18n="hero.visual.infra">infra</span><span data-i18n="hero.visual.cloud">cloud</span><span data-i18n="hero.visual.dados">dados</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const heroVideo = document.querySelector<HTMLVideoElement>('.hero-video');
  const heroFallback = document.querySelector<HTMLImageElement>('.hero-fallback');

  if (heroVideo && heroFallback) {
    heroVideo.addEventListener('error', () => {
      const fallbackSource = heroFallback.dataset.src;
      if (fallbackSource) heroFallback.src = fallbackSource;
      heroVideo.hidden = true;
      heroFallback.hidden = false;
    }, { once: true });
  }
</script>

<style>
  .hero-description {
    margin-top: 20px;
    color: var(--color-muted);
    font-size: 0.95rem;
    line-height: 1.7;
    max-width: 440px;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px
  }
  .hero-visual {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 14px;
    align-items: center;
    min-width: 0;
  }
  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 10px;
    opacity: 0.4;
    z-index: 0;
  }
  .hero-fallback {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 10px;
    opacity: 0.4;
    z-index: 0;
  }
  .visual-top,
  .visual-bottom {
    display: flex;
    gap: 16px;
    font: 0.62rem monospace;
    letter-spacing: 0.1em;
    color: var(--color-muted);
    position: relative;
    z-index: 1;
  }
  .visual-top span:first-child,
  .visual-bottom span:first-child {
    color: var(--color-gold);
  }
  @media (max-width: 760px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .hero-copy,
    .hero-description {
      max-width: 100%;
    }
    .hero-video {
      opacity: 0.3;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-video,
    .hero-fallback {
      display: none;
    }
  }
</style>