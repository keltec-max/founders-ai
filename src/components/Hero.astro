---
---

<section class="hero" aria-labelledby="hero-title" aria-describedby="hero-desc">
  <div class="container">
    <div class="hero-grid">
      <div class="hero-copy">
        <p class="eyebrow" data-i18n="hero.eyebrow">Consultoria de inteligência artificial e infraestrutura</p>
        <h1 id="hero-title" data-i18n="hero.title">IA aplicada <em class="accent">com infraestrutura de confiança</em></h1>
        <p id="hero-desc" class="hero-description" data-i18n="hero.desc">
          Ajudamos empresas a adotar Copilot, ChatGPT Enterprise, Claude e modelos open-source com
          governança, servidores adequados e implantação em escala — da estratégia ao ambiente de
          produção.
        </p>
        <div class="hero-actions">
          <a href="#contato" class="button button-primary" data-i18n="hero.btn-iniciar">Iniciar projeto</a>
          <a href="#servicos" class="button button-secondary" data-i18n="hero.btn-servicos">Ver serviços</a>
        </div>
      </div>
      <div class="hero-visual" aria-hidden="true">
        <div class="visual-top">
          <span data-i18n="hero.visual.ia01">ia-01</span><span data-i18n="hero.visual.ativo">ativo</span><span data-i18n="hero.visual.producao">produção</span>
        </div>
        <div class="rack-group">
          <div class="rack">
            <div class="led led-on"></div>
            <div class="led"></div>
            <div class="led led-on"></div>
            <div class="led"></div>
          </div>
          <div class="rack">
            <div class="led"></div>
            <div class="led led-on"></div>
            <div class="led"></div>
            <div class="led led-on"></div>
          </div>
          <div class="rack">
            <div class="led led-on"></div>
            <div class="led"></div>
            <div class="led led-on"></div>
            <div class="led"></div>
          </div>
        </div>
        <div class="visual-bottom">
          <span data-i18n="hero.visual.infra">infra</span><span data-i18n="hero.visual.cloud">cloud</span><span data-i18n="hero.visual.dados">dados</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-description {
    margin-top: 20px;
    color: var(--color-muted);
    font-size: 0.95rem;
    line-height: 1.7;
    max-width: 440px;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }
  .hero-visual {
    display: flex;
    flex-direction: column;
    gap: 14px;
    align-items: center;
    min-width: 0;
  }
  .visual-top,
  .visual-bottom {
    display: flex;
    gap: 16px;
    font: 0.62rem monospace;
    letter-spacing: 0.1em;
    color: var(--color-muted);
  }
  .visual-top span:first-child,
  .visual-bottom span:first-child {
    color: var(--color-gold);
  }
  .rack-group {
    display: flex;
    gap: 10px;
    height: 200px;
    align-items: flex-end;
  }
  .rack {
    width: 44px;
    border: 1px solid var(--color-line);
    background: var(--color-panel);
    border-radius: 6px;
    display: flex;
    flex-direction: column-reverse;
    padding: 8px 4px;
    gap: 6px;
  }
  .rack:nth-child(1) {
    height: 60%;
  }
  .rack:nth-child(2) {
    height: 72%;
  }
  .rack:nth-child(3) {
    height: 66%;
  }
  .led {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #303335;
  }
  .led-on {
    background: var(--color-gold);
    box-shadow: 0 0 10px var(--color-gold);
    animation: led-intro 2s ease-in-out 2 both;
  }
  @media (max-width: 760px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .hero-copy,
    .hero-description {
      max-width: 100%;
    }
  }
</style>
