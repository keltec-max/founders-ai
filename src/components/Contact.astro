---
interface Props {
  className?: string
}
const { className = '' } = Astro.props
---

<section id="contato" class="section bg-slate-950 relative {className}" aria-labelledby="contact-title">
  <div class="container-custom">
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="inline-block px-4 py-2 rounded-full bg-slate-900/50 border border-slate-700/50 text-gold-400 text-sm font-medium mb-6">
        Vamos Conversar
      </span>
      <h2 id="contact-title" class="section-title text-gradient-gold">
        Pronto para Transformar<br /><span class="text-slate-100">Sua Empresa com IA?</span>
      </h2>
      <p class="section-subtitle mx-auto">
        Agende uma conversa sem compromisso. Entendemos seu contexto, apresentamos o roadmap
        e definimos os próximos passos juntos.
      </p>
    </div>

    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16">
      <!-- Contact Info -->
      <div class="space-y-8">
        <div class="card p-6 lg:p-8">
          <h3 class="text-xl font-bold text-slate-100 font-space-grotesk mb-6">Entre em Contato</h3>
          <div class="space-y-6">
            <a href="mailto:contato@founders.ai" class="flex items-center gap-4 p-4 bg-slate-950/50 border border-slate-800/50 rounded-xl hover:border-gold-500/30 hover:bg-slate-900/80 transition-all duration-300 group">
              <div class="flex-shrink-0 w-12 h-12 rounded-lg bg-gradient-to-br from-gold-500/20 to-gold-600/10 border border-gold-500/30 flex items-center justify-center group-hover:border-gold-500 group-hover:bg-gradient-to-br from-gold-500/30 to-gold-600/20 transition-all duration-300">
                <svg class="w-6 h-6 text-gold-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </div>
              <div>
                <p class="text-slate-500 text-sm">E-mail Comercial</p>
                <p class="text-slate-100 font-medium group-hover:text-gold-400 transition-colors">contato@founders.ai</p>
              </div>
            </a>

            <a href="tel:+5511999999999" class="flex items-center gap-4 p-4 bg-slate-950/50 border border-slate-800/50 rounded-xl hover:border-gold-500/30 hover:bg-slate-900/80 transition-all duration-300 group">
              <div class="flex-shrink-0 w-12 h-12 rounded-lg bg-gradient-to-br from-gold-500/20 to-gold-600/10 border border-gold-500/30 flex items-center justify-center group-hover:border-gold-500 group-hover:bg-gradient-to-br from-gold-500/30 to-gold-600/20 transition-all duration-300">
                <svg class="w-6 h-6 text-gold-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                </svg>
              </div>
              <div>
                <p class="text-slate-500 text-sm">Telefone / WhatsApp</p>
                <p class="text-slate-100 font-medium group-hover:text-gold-400 transition-colors">+55 (11) 99999-9999</p>
              </div>
            </a>

            <div class="flex items-center gap-4 p-4 bg-slate-950/50 border border-slate-800/50 rounded-xl">
              <div class="flex-shrink-0 w-12 h-12 rounded-lg bg-gradient-to-br from-gold-500/20 to-gold-600/10 border border-gold-500/30 flex items-center justify-center">
                <svg class="w-6 h-6 text-gold-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <p class="text-slate-500 text-sm">Endereço</p>
                <p class="text-slate-100 font-medium">São Paulo, SP — Atendimento Remoto Nacional</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Social Links -->
        <div class="card p-6 lg:p-8">
          <h3 class="text-xl font-bold text-slate-100 font-space-grotesk mb-6">Acompanhe-nos</h3>
          <div class="flex flex-wrap gap-3">
            <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 px-4 py-2 bg-slate-950/50 border border-slate-800/50 rounded-lg hover:border-gold-500/50 hover:bg-gold-500/10 transition-all duration-300 text-sm" aria-label="LinkedIn">
              <svg class="w-4 h-4 text-gold-500" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              LinkedIn
            </a>
            <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 px-4 py-2 bg-slate-950/50 border border-slate-800/50 rounded-lg hover:border-gold-500/50 hover:bg-gold-500/10 transition-all duration-300 text-sm" aria-label="GitHub">
              <svg class="w-4 h-4 text-gold-500" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
              GitHub
            </a>
            <a href="mailto:contato@founders.ai" class="flex items-center gap-2 px-4 py-2 bg-slate-950/50 border border-slate-800/50 rounded-lg hover:border-gold-500/50 hover:bg-gold-500/10 transition-all duration-300 text-sm" aria-label="E-mail">
              <svg class="w-4 h-4 text-gold-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              E-mail
            </a>
          </div>
        </div>
      </div>

      <!-- Contact Form -->
      <div class="card p-6 lg:p-8">
        <h3 class="text-xl font-bold text-slate-100 font-space-grotesk mb-6">Envie uma Mensagem</h3>

        <!-- Formspree form - works on GitHub Pages -->
        <form action="https://formspree.io/f/SEU_FORM_ID" method="POST" class="space-y-5" id="contact-form" novalidate>
          <input type="hidden" name="_next" value="/obrigado" />
          <input type="hidden" name="_subject" value="Nova mensagem do site Founders AI" />
          <input type="hidden" name="_gotcha" style="display:none" />

          <!-- Honeypot for spam protection -->
          <div style="display: none;" aria-hidden="true">
            <label for="website">Website</label>
            <input type="text" name="website" id="website" tabindex="-1" autocomplete="off" />
          </div>

          <div class="grid sm:grid-cols-2 gap-5">
            <div>
              <label for="nome" class="label-field">Nome Completo <span class="text-gold-500" aria-hidden="true">*</span></label>
              <input
                type="text"
                id="nome"
                name="nome"
                class="input-field"
                placeholder="Seu nome"
                required
                aria-required="true"
                autocomplete="name"
              />
              <p class="sr-only" aria-live="polite" id="nome-error"></p>
            </div>
            <div>
              <label for="email" class="label-field">E-mail Corporativo <span class="text-gold-500" aria-hidden="true">*</span></label>
              <input
                type="email"
                id="email"
                name="email"
                class="input-field"
                placeholder="seu@email.com"
                required
                aria-required="true"
                autocomplete="email"
              />
              <p class="sr-only" aria-live="polite" id="email-error"></p>
            </div>
          </div>

          <div class="grid sm:grid-cols-2 gap-5">
            <div>
              <label for="empresa" class="label-field">Empresa</label>
              <input
                type="text"
                id="empresa"
                name="empresa"
                class="input-field"
                placeholder="Nome da empresa"
                autocomplete="organization"
              />
            </div>
            <div>
              <label for="telefone" class="label-field">Telefone / WhatsApp</label>
              <input
                type="tel"
                id="telefone"
                name="telefone"
                class="input-field"
                placeholder="(11) 99999-9999"
                autocomplete="tel"
              />
            </div>
          </div>

          <div>
            <label for="assunto" class="label-field">Assunto <span class="text-gold-500" aria-hidden="true">*</span></label>
            <select id="assunto" name="assunto" class="input-field appearance-none" required aria-required="true">
              <option value="">Selecione um assunto</option>
              <option value="consultoria-ia">Consultoria em IA Generativa</option>
              <option value="implementacao">Implementação Copilot / ChatGPT / Claude</option>
              <option value="infraestrutura">Infraestrutura & Servidores</option>
              <option value="cloud">Cloud Híbrida & Kubernetes</option>
              <option value="seguranca">Segurança & Compliance IA</option>
              <option value="dados">Data Engineering & MLOps</option>
              <option value="outro">Outro</option>
            </select>
            <p class="sr-only" aria-live="polite" id="assunto-error"></p>
          </div>

          <div>
            <label for="mensagem" class="label-field">Mensagem <span class="text-gold-500" aria-hidden="true">*</span></label>
            <textarea
              id="mensagem"
              name="mensagem"
              rows="5"
              class="input-field resize-none"
              placeholder="Conte-nos sobre seu desafio, objetivos e como podemos ajudar..."
              required
              aria-required="true"
            ></textarea>
            <p class="sr-only" aria-live="polite" id="mensagem-error"></p>
          </div>

          <div class="flex items-start gap-3">
            <input
              type="checkbox"
              id="lgpd"
              name="lgpd"
              class="mt-1 w-4 h-4 rounded border-slate-700 text-gold-500 focus:ring-2 focus:ring-gold-500 focus:ring-offset-2 focus:ring-offset-slate-950"
              required
              aria-required="true"
            />
            <label for="lgpd" class="text-sm text-slate-400 leading-relaxed">
              Concordo com o processamento dos meus dados conforme a <a href="/privacidade" class="text-gold-400 hover:underline">Política de Privacidade</a> e a <a href="/termos" class="text-gold-400 hover:underline">LGPD</a>.
              <span class="text-gold-500" aria-hidden="true">*</span>
            </label>
          </div>

          <button
            type="submit"
            class="btn-primary w-full sm:w-auto"
            id="submit-btn"
          >
            <span class="btn-text">Enviar Mensagem</span>
            <span class="btn-loading hidden">
              <svg class="animate-spin h-5 w-5" fill="none" viewBox="0 0 24 24" aria-hidden="true">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <circle class="opacity-75" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" stroke-dasharray="30" stroke-dashoffset="100"></circle>
              </svg>
              Enviando...
            </span>
          </button>

          <p class="text-xs text-slate-500 text-center">
            Responderemos em até 24h úteis. Para urgências, chame no WhatsApp.
          </p>
        </form>

        <!-- Success/Error Toast Container -->
        <div id="form-toast" class="hidden fixed bottom-6 right-6 z-50 max-w-sm" role="alert" aria-live="polite"></div>
      </div>
    </div>

    <!-- Alternative: Calendly-style scheduling mention -->
    <div class="mt-16 text-center">
      <div class="inline-flex items-center gap-4 p-6 bg-slate-900/50 border border-slate-800/50 rounded-2xl max-w-2xl">
        <div class="flex-shrink-0 w-14 h-14 rounded-xl bg-gradient-to-br from-gold-500/20 to-gold-600/10 border border-gold-500/30 flex items-center justify-center">
          <svg class="w-7 h-7 text-gold-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
        </div>
        <div class="text-left">
          <p class="font-semibold text-slate-100">Prefere agendar direto na agenda?</p>
          <p class="text-sm text-slate-400 mt-1">Escolha o melhor horário para uma call de descoberta de 30 min.</p>
          <a href="https://calendly.com/founders-ai" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 mt-3 text-sm font-medium text-gold-400 hover:text-gold-300 transition-colors">
            Agendar Call
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Form handling with Formspree + toast notifications
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('contact-form');
    const submitBtn = document.getElementById('submit-btn');
    const btnText = submitBtn.querySelector('.btn-text');
    const btnLoading = submitBtn.querySelector('.btn-loading');
    const toastContainer = document.getElementById('form-toast');

    if (!form) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Client-side validation
      if (!validateForm(form)) {
        showToast('Por favor, preencha todos os campos obrigatórios corretamente.', 'error');
        return;
      }

      // Show loading state
      submitBtn.disabled = true;
      btnText.classList.add('hidden');
      btnLoading.classList.remove('hidden');

      try {
        const formData = new FormData(form);
        const response = await fetch(form.action, {
          method: 'POST',
          body: formData,
          headers: { 'Accept': 'application/json' }
        });

        if (response.ok) {
          showToast('Mensagem enviada com sucesso! Retornaremos em até 24h úteis.', 'success');
          form.reset();
        } else {
          const data = await response.json();
          throw new Error(data.error || 'Erro ao enviar mensagem');
        }
      } catch (error) {
        console.error('Form submission error:', error);
        showToast('Erro ao enviar. Tente novamente ou chame no WhatsApp.', 'error');
      } finally {
        submitBtn.disabled = false;
        btnText.classList.remove('hidden');
        btnLoading.classList.add('hidden');
      }
    });

    function validateForm(form) {
      let isValid = true;
      const requiredFields = form.querySelectorAll('[required]');

      requiredFields.forEach(field => {
        const errorEl = document.getElementById(`${field.id}-error`);
        if (!field.value.trim()) {
          isValid = false;
          field.classList.add('border-red-500', 'focus:ring-red-500');
          field.classList.remove('border-slate-700/50', 'focus:ring-gold-500');
          if (errorEl) errorEl.textContent = 'Este campo é obrigatório';
        } else {
          field.classList.remove('border-red-500', 'focus:ring-red-500');
          field.classList.add('border-slate-700/50', 'focus:ring-gold-500');
          if (errorEl) errorEl.textContent = '';
        }

        // Email validation
        if (field.type === 'email' && field.value.trim()) {
          const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
          if (!emailRegex.test(field.value)) {
            isValid = false;
            field.classList.add('border-red-500', 'focus:ring-red-500');
            if (errorEl) errorEl.textContent = 'E-mail inválido';
          }
        }
      });

      return isValid;
    }

    function showToast(message, type) {
      const toast = document.createElement('div');
      toast.className = `p-4 rounded-xl shadow-2xl animate-slide-in ${
        type === 'success'
          ? 'bg-green-900/90 border border-green-500/30 text-green-100'
          : 'bg-red-900/90 border border-red-500/30 text-red-100'
      }`;
      toast.innerHTML = `
        <div class="flex items-center gap-3">
          <svg class="w-5 h-5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
            ${type === 'success'
              ? '<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>'
              : '<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>'
            }
          </svg>
          <p class="text-sm">${message}</p>
        </div>
      `;
      toastContainer.appendChild(toast);
      toastContainer.classList.remove('hidden');

      setTimeout(() => {
        toast.classList.add('animate-fade-out');
        setTimeout(() => toast.remove(), 300);
        if (toastContainer.children.length === 0) toastContainer.classList.add('hidden');
      }, 6000);
    }
  });
</script>

<style>
  @keyframes slide-in {
    from { opacity: 0; transform: translateX(100%); }
    to { opacity: 1; transform: translateX(0); }
  }
  @keyframes fade-out {
    from { opacity: 1; transform: translateX(0); }
    to { opacity: 0; transform: translateX(100%); }
  }
  .animate-slide-in { animation: slide-in 0.3s ease-out; }
  .animate-fade-out { animation: fade-out 0.3s ease-in forwards; }

  @media (prefers-reduced-motion: reduce) {
    .animate-slide-in, .animate-fade-out, .animate-spin { animation: none !important; }
  }
</style>