---
const base = import.meta.env.BASE_URL;
const languages = [
  { code: 'pt', country: 'br', label: 'Português (Brasil)' },
  { code: 'en', country: 'us', label: 'English (United States)' },
  { code: 'de', country: 'de', label: 'Deutsch (Deutschland)' },
  { code: 'es', country: 'es', label: 'Español (España)' },
];
---

<div class="language-selector" role="group" aria-label="Seleção de idioma">
  {languages.map(({ code, country, label }) => (
    <button
      type="button"
      data-lang={code}
      data-i18n={`selector.button.${code}`}
      data-i18n-attr="aria-label"
      aria-label={label}
      title={label}
      aria-pressed={code === 'pt' ? 'true' : 'false'}
    >
      <img src={`${base}flags/${country}.svg`} width="28" height="21" alt="" />
    </button>
  ))}
</div>

<style>
  .language-selector {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }
  .language-selector button {
    background: transparent;
    border: 1px solid var(--color-line);
    color: var(--color-text);
    width: 44px;
    height: 44px;
    padding: 7px;
    border-radius: 4px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: border-color 0.2s;
  }
  .language-selector img {
    display: block;
    width: 28px;
    height: 21px;
    border-radius: 2px;
  }
  .language-selector button:hover {
    border-color: var(--color-gold);
  }
  .language-selector button[aria-pressed="true"] {
    border-color: var(--color-gold);
    background: var(--color-panel);
  }
</style>
