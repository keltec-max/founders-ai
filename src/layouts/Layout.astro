      function getStoredLang() {
        if (typeof window === 'undefined') return DEFAULT_LANG;
        try {
          const stored = localStorage.getItem(STORAGE_KEY);
          if (VALID_LANGS.includes(stored)) return stored;
        } catch { /* ignore — private browsing may block localStorage */ }
        return DEFAULT_LANG;
      }

      function setHtmlLang(lang) {
        document.documentElement.lang = LANG_HTML[lang];
      }

      const HTML_KEYS = new Set(['hero.title', 'tech.title']);

      function applyTranslations(lang) {
        const dict = translations[lang];
        const elements = document.querySelectorAll('[data-i18n]');
        for (const el of elements) {
          const key = el.getAttribute('data-i18n');
          if (!key) continue;
          const value = dict[key];
          if (value === undefined) continue;
          const attr = el.getAttribute('data-i18n-attr');
          if (attr) {
            el.setAttribute(attr, value);
          } else if (HTML_KEYS.has(key)) {
            el.innerHTML = value;
          } else {
            el.textContent = value;
          }
        }
      }

      function updateActiveButton(activeLang) {
        const buttons = document.querySelectorAll('[data-lang]');
        for (const btn of buttons) {
          const isActive = btn.getAttribute('data-lang') === activeLang;
          btn.setAttribute('aria-pressed', String(isActive));
        }
      }

      function initI18n() {
        const lang = getStoredLang();
        try { localStorage.setItem(STORAGE_KEY, lang); } catch { /* ignore */ }
        setHtmlLang(lang);
        applyTranslations(lang);
        updateActiveButton(lang);

        const buttons = document.querySelectorAll('[data-lang]');
        for (const btn of buttons) {
          btn.addEventListener('click', () => {
            const clicked = btn.getAttribute('data-lang');
            if (!clicked || !VALID_LANGS.includes(clicked)) return;
            try { localStorage.setItem(STORAGE_KEY, clicked); } catch { /* ignore */ }
            setHtmlLang(clicked);
            applyTranslations(clicked);
            updateActiveButton(clicked);
          });
        }
      }

      initI18n();
    </script>
