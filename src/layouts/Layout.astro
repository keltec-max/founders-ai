---
interface Props {
  title: string
  description?: string
  image?: string
}

const { title, description = "Founders AI - Consultoria especializada em Inteligência Artificial, Infraestrutura de Servidores e Soluções Corporativas", image = "/og-image.jpg" } = Astro.props
---

<!doctype html>
<html lang="pt-BR" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#020617" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:locale" content="pt_BR" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />

    <!-- Preconnect for external resources -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Fonts -->
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap" media="print" onload="this.media='all'" />

    <!-- Security headers via meta -->
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta http-equiv="Referrer-Policy" content="strict-origin-when-cross-origin" />

    <!-- Import global styles -->
    <script is:inline>
      // Prevent FOUC
      document.documentElement.classList.add('js-enabled')
    </script>
  </head>
  <body class="bg-slate-950 text-slate-100 font-inter antialiased">
    <!-- Skip link for accessibility -->
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-gold-500 focus:text-slate-950 focus:rounded-lg focus:font-semibold">
      Pular para o conteúdo principal
    </a>

    <slot />

    <!-- Footer -->
    <footer class="border-t border-slate-800/50 bg-slate-950/80 backdrop-blur-sm" role="contentinfo">
      <div class="container-custom py-12 lg:py-16">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8 lg:gap-12">
          <!-- Brand -->
          <div class="md:col-span-2 lg:col-span-1">
            <a href="/" class="flex items-center gap-3" aria-label="Founders AI - Início">
              <span class="text-3xl font-bold text-gradient-gold font-space-grotesk" aria-hidden="true">F</span>
              <span class="text-xl font-bold text-slate-100 font-space-grotesk">Founders AI</span>
            </a>
            <p class="mt-4 text-slate-400 text-sm leading-relaxed max-w-xs">
              Transformamos desafios corporativos em vantagens competitivas através de Inteligência Artificial e infraestrutura de ponta.
            </p>
            <div class="mt-6 flex gap-4" role="list" aria-label="Redes sociais">
              <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="text-slate-400 hover:text-gold-500 transition-colors" aria-label="LinkedIn">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              </a>
              <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="text-slate-400 hover:text-gold-500 transition-colors" aria-label="GitHub">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
              </a>
              <a href="mailto:contato@founders.ai" class="text-slate-400 hover:text-gold-500 transition-colors" aria-label="E-mail">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              </a>
            </div>
          </div>

          <!-- Links rápidos -->
          <nav aria-label="Links rápidos">
            <h3 class="font-semibold text-gold-400 mb-4">Navegação</h3>
            <ul class="space-y-2" role="list">
              <li><a href="#sobre" class="text-slate-400 hover:text-gold-500 transition-colors text-sm">Sobre nós</a></li>
              <li><a href="#servicos" class="text-slate-400 hover:text-gold-500 transition-colors text-sm">Serviços</a></li>
              <li><a href="#tecnologias" class="text-slate-400 hover:text-gold-500 transition-colors text-sm">Tecnologias</a></li>
              <li><a href="#contato" class="text-slate-400 hover:text-gold-500 transition-colors text-sm">Contato</a></li>
            </ul>
          </nav>

          <!-- Serviços -->
          <nav aria-label="Nossos serviços">
            <h3 class="font-semibold text-gold-400 mb-4">Serviços</h3>
            <ul class="space-y-2" role="list">
              <li><a href="#servicos" class="text-slate-400 hover:text-gold-500 transition-colors text-sm">Consultoria em IA</a></li>
              <li><a href="#servicos" class="text-slate-400 hover:text-gold-500 transition-colors text-sm">Infraestrutura & Servidores</a></li>
              <li><a href="#servicos" class="text-slate-400 hover:text-gold-500 transition-colors text-sm">Planejamento Estratégico</a></li>
              <li><a href="#servicos" class="text-slate-400 hover:text-gold-500 transition-colors text-sm">Implementação & Treinamento</a></li>
            </ul>
          </nav>
        </div>

        <div class="mt-12 pt-8 border-t border-slate-800/50">
          <div class="flex flex-col md:flex-row justify-between items-center gap-4">
            <p class="text-slate-500 text-sm">
              © {new Date().getFullYear()} Founders AI. Todos os direitos reservados.
            </p>
            <div class="flex gap-6 text-sm text-slate-500">
              <a href="/privacidade" class="hover:text-gold-500 transition-colors">Política de Privacidade</a>
              <a href="/termos" class="hover:text-gold-500 transition-colors">Termos de Uso</a>
            </div>
          </div>
        </div>
      </div>
    </footer>

    <!-- Scripts -->
    <script is:inline src="/scripts/main.js"></script>
  </body>
</html>

<style is:global>
  /* Font families */
  .font-space-grotesk { font-family: 'Space Grotesk', sans-serif; }
  .font-inter { font-family: 'Inter', sans-serif; }

  /* Screen reader only */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Focus visible for accessibility */
  :focus-visible {
    outline: 2px solid #d0ac3c;
    outline-offset: 2px;
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }

  /* Print styles */
  @media print {
    .no-print { display: none !important; }
    body { background: white !important; color: black !important; }
  }
</style>